{
  "name": "inflow",
  "version": "0.6.1",
  "description": "A better inbox for LinkedIn messaging — a Chrome extension.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "zip:store": "INFLOW_STORE_BUILD=1 wxt zip",
    "changelog:site": "node scripts/build-changelog.mjs",
    "og": "node scripts/build-og.mjs",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@wxt-dev/module-react": "^1.2.2",
    "cmdk": "^1.1.1",
    "date-fns": "^4.3.0",
    "dexie": "^4.4.2",
    "dexie-react-hooks": "^4.4.0",
    "gemoji": "^8.1.0",
    "nanoid": "^5.1.16",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "wxt": "^0.21.4",
    "zustand": "^5.0.13"
  },
  "overrides": {
    "vite": ">=8.0.16",
    "undici": "^7.29.0",
    "postcss": {
      ".": "^8.5.23",
      "nanoid": "^3.3.16"
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.1.42",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.7",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
